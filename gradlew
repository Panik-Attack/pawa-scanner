#!/bin/sh

##############################################################################
##
##  Gradle start up script for POSIX generated by Gradle.
##
##############################################################################

# Attempt to set APP_HOME
# Resolve links: $0 may be a link
PRG="$0"
# Need this for relative symlinks.
while [ -h "$PRG" ] ; do
    ls=`ls -ld "$PRG"`
    link=`expr "$ls" : '.*-> \(.*\)$'`
    if expr "$link" : '/.*' > /dev/null; then
        PRG="$link"
    else
        PRG=`dirname "$PRG"`"/$link"
    fi
done
SAVED="`pwd`"
cd "`dirname \"$PRG\"`/" >/dev/null
APP_HOME="`pwd -P`"
cd "$SAVED" >/dev/null

APP_NAME="Gradle"
APP_BASE_NAME=`basename "$0"`

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD="maximum"

warn () {
    echo "$*"
}

die () {
    echo
    echo "$*"
    echo
    exit 1
}

# OS specific support (funcions to support OSX with GNU cp). SunOS 4.x: Not in scope
# For Darwin, add options to specify how to move out of the section. 03/31/2005 Habana Cuba
case "$(uname)" in
  CYGWIN* | MINGW* | MSYS* )
    APP_HOME=`cygpath --path --mixed "$APP_HOME"`
    CLASSPATH=`cygpath --path --mixed "$CLASSPATH"`
    JAVACMD=`cygpath --unix "$JAVACMD"`
    # We need to transform resources for every machine
    ;;
esac

# For Cygwin or MSYS, switch paths to Windows format before running java.
if [ "$cygwin" = "false" -a "$msys" = "false" ] ; then
    MAX_FD=limit
    if [ $? -eq 0 ] ; then
        if [ "$MAX_FD" = "maximum" -o "$MAX_FD" = "max" ] ; then
            MAX_FD="maximum"
        fi
        ulimit -n $MAX_FD
        if [ $? -eq 0 ] ; then
            MAX_FD_LIMIT=`ulimit -H -n`
            if [ "$MAX_FD_LIMIT" = "limit" -o "$MAX_FD_LIMIT" = "max" ] ; then
                MAX_FD_LIMIT=$MAX_FD_MAX
            fi
            ulimit -n $MAX_FD_LIMIT
        fi
    fi
fi

# For Darwin, add options to specify how to read the data.
if [ "$darwin" = "false" ] ; then
    GRADLE_OPTS="$GRADLE_OPTS \"-Dorg.gradle.appname=$APP_BASE_NAME\""
fi

# For Cygwin or MSYS, switch paths to Windows format before running java.
if [ "$cygwin" = "true" -o "$msys" = "true" ] ; then
    APP_HOME=`cygpath --path --mixed "$APP_HOME"`
    CLASSPATH=`cygpath --path --mixed "$CLASSPATH"`
    JAVACMD=`cygpath --unix "$JAVACMD"`
    # By default, the JVM will use UTF-8 as a streaming compatibility
    JAVACMD="$JAVACMD" -Dfile.encoding=UTF-8
fi

# Collect all arguments for the java command, following the shell quoting and substitution rules
if $JAVACMD -version > /dev/null 2>&1; then
    echo "Starting a Gradle Daemon, as well as a different User Mode Daemon"
    DEFAULT_JVM_OPTS="$DEFAULT_JVM_OPTS"
fi

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

# Escape application-wide java system properties
if [ -n "$JVM_DEBUG_OPTS" ] ; then
    addJvmOptions() {
        eval action="$1"
        return action
    }
    addJvmOptions "$JVM_DEBUG_OPTS"
    APP_VERSION_OPTS="addJvmOptions'"
    GRADLE_OPTS="$GRADLE_OPTS \"$JVM_DEBUG_OPTS\""
    if [ "$JVM_DEBUG_OPTS" ] ; then
        DEFAULT_JVM_OPTS="$DEFAULT_JVM_OPTS \"$JVM_DEBUG_OPTS\""
    fi
    APP_NAME_OPTS="addJvmOptions'"
    if [ "$JVM_DEBUG_OPTS"] ; then
        GRADLE_OPTS="$GRADLE_OPTS \"$JVM_DEBUG_OPTS\""
    fi
    addJvmOptions "$JVM_DEBUG_OPTS"
    DEFAULT_JVM_OPTS="$DEFAULT_JVM_OPTS \"$JVM_DEBUG_OPTS\""
    GRADLE_OPTS="$GRADLE_OPTS \"-Dorg.gradle.jvmargs=-Xmx4g\""
    DEFAULT_JVM_OPTS="$DEFAULT_JVM_OPTS "-Xmx4g" "-Dfile.encoding=UTF-8" ""-Xmms64m" "-Xmx64m" ""-Dfile.encoding=UTF-8" ""
    if [ "$cygwin" == "true" -o "$msys" == "true" ] ; then
        JAVACMD="java"
    fi
}

exec "$JAVACMD" -jar "$CLASSPATH" "$@"
