<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Pawa.GlassPanel" parent="">
        <item name="android:background">@drawable/bg_glass_panel</item>
        <item name="android:elevation">@dimen/elevation_glass</item>
        <item name="android:clipToOutline">true</item>
    </style>

    <style name="Widget.Pawa.GlassPanel.Strong" parent="">
        <item name="android:background">@drawable/bg_glass_panel_strong</item>
        <item name="android:elevation">@dimen/elevation_glass</item>
        <item name="android:clipToOutline">true</item>
    </style>

    <style name="Widget.Pawa.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:height">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/on_pawa_green</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/pawa_green</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="rippleColor">@color/pawa_green_dark</item>
    </style>

    <!-- Input de tracking: vidrio, radio 16dp, foco con borde verde pawa y glow. -->
    <style name="Widget.Pawa.Input.Glass" parent="">
        <item name="android:background">@drawable/input_glass_selector</item>
        <item name="android:padding">16dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:maxLines">1</item>
        <item name="android:imeOptions">actionDone</item>
        <item name="android:inputType">text|textNoSuggestions</item>
    </style>

    <!-- Botón secundario de vidrio para acciones junto al input. -->
    <style name="Widget.Pawa.Button.Secondary" parent="Widget.Material3.Button">
        <item name="android:height">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/btn_secondary_fill</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/btn_secondary_stroke</item>
        <item name="cornerRadius">@dimen/radius_chips_inputs</item>
        <item name="rippleColor">@color/pawa_green_light</item>
    </style>
</resources>