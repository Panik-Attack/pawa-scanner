<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de vidrio para el input de tracking. Radio 16dp, borde outline, highlight superior. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill_dark" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/glass_border" />
            <corners android:radius="16dp" />
            <padding
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp" />
        </shape>
    </item>
    <item>
        <inset
            android:insetBottom="1dp"
            android:insetLeft="1dp"
            android:insetRight="1dp"
            android:insetTop="1dp">
            <shape android:shape="rectangle">
                <solid android:color="@android:color/transparent" />
                <corners android:radius="15dp" />
                <stroke android:width="1dp" android:color="@color/glass_highlight" />
            </shape>
        </inset>
    </item>
</layer-list>
